.a {
    margin: 0;        /* want "the unit on zero is meaningless" */
    padding: 0;       /* want "the unit on zero is meaningless" */
    border: 0;          /* OK */
    width: 100px;       /* OK */
    height: 100%;       /* OK */
    line-height: 0;    /* want "the unit on zero is meaningless" */
}
